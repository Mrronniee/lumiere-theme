<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}
  {%- liquid
    assign heading_bold = settings.font_heading | font_modify: 'weight', 'bold'
    assign body_bold = settings.font_body | font_modify: 'weight', 'bold'
  -%}
  {% style %}
    {{ settings.font_heading | font_face: font_display: 'swap' }}
    {{ heading_bold | font_face: font_display: 'swap' }}
    {{ settings.font_body | font_face: font_display: 'swap' }}
    {{ body_bold | font_face: font_display: 'swap' }}
  {% endstyle %}
  {{ content_for_header }}
  {% render 'css-variables' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
</head>
<body class="template-password">
  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
