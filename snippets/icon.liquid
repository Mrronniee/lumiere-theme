{% comment %}
  Snippet d'icones SVG reutilisables
  Usage: {% render 'icon', name: 'cart', class: 'icon-class' %}
{% endcomment %}

{%- liquid
  assign icon_stroke = settings.icon_stroke_width | default: 15 | divided_by: 10.0
  assign icon_px = settings.icon_size | default: 24
-%}
{%- case icon -%}
  {%- when 'cart' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-cart {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>

  {%- when 'search' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-search {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="8"></circle>
      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    </svg>

  {%- when 'user' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-user {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
      <circle cx="12" cy="7" r="4"></circle>
    </svg>

  {%- when 'menu' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-menu {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>

  {%- when 'close' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-close {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>

  {%- when 'arrow-right' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-arrow-right {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>

  {%- when 'arrow-left' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-arrow-left {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>

  {%- when 'instagram' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-instagram {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
      <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
      <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
    </svg>

  {%- when 'heart' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-heart {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>

  {%- when 'check' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-check {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="20 6 9 17 4 12"></polyline>
    </svg>

  {%- when 'chevron-down' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-chevron-down {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>

  {%- when 'share' -%}
    <svg aria-hidden="true" focusable="false" class="icon icon-share {{ class }}" xmlns="http://www.w3.org/2000/svg" width="{{ icon_px }}" height="{{ icon_px }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ icon_stroke }}" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>

{%- endcase -%}
