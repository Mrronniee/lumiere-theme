    "faq": {
      "type": "faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>Orders are prepared within 24 to 48 working hours, then delivered in 2 to 4 days.</p>"
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Can I return an item?",
            "answer": "<p>You have 30 days after receipt to return an unworn item to us, in its original packaging. Refunds are issued within 5 working days.</p>"
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "How do I choose my size?",
            "answer": "<p>Every product page includes a detailed size guide. If you are between two sizes, we recommend taking the larger one.</p>"
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "Do you ship internationally?",
            "answer": "<p>Yes, we ship throughout the European Union, Switzerland and the United Kingdom. Shipping costs and delivery times are calculated at checkout.</p>"
          }
        }
      },
      "block_order": [
        "question_1",
        "question_2",
        "question_3",
        "question_4"
