            "title": "Description",
            "content": "<p>A straight cut, a clean drape and careful finishing. Every piece is made to last, season after season.</p>"
          }
        },
        "tab_2": {
          "type": "tab",
          "settings": {
            "title": "Composition",
            "content": "<p>70% merino wool, 30% cashmere. Woven in Italy, made up in Portugal by a partner atelier of ten years.</p>"
          }
        },
        "tab_3": {
          "type": "tab",
          "settings": {
            "title": "Care",
            "content": "<p>Hand wash at 30°C or dry clean. Dry flat, out of direct light. Do not tumble dry.</p>"
          }
        },
        "tab_4": {
          "type": "tab",
          "settings": {
            "title": "Shipping & returns",
            "content": "<p>Shipped within 48 working hours, free delivery over €120. Free returns for 30 days after receipt.</p>"
