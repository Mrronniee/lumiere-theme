          }
        },
        {
          "type": "slide",
          "settings": {
            "pretitle": "Savoir-faire",
            "title": "Made in Europe",
            "text": "Every piece is made in partner ateliers, to our exacting standards.",
            "button_label": "Our story"
          }
        }
      ]
    }
  ]
}
