          "info": "t:sections.slideshow.blocks.slide.settings.text_color.info",
          "default": "#ffffff"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "default": 30,
          "unit": "%",
