{% comment %}Section: Connexion client{% endcomment %}
{%- liquid
  assign recover_errors_id = 'RecoverErrors-' | append: section.id
  assign login_errors_id = 'LoginErrors-' | append: section.id
-%}
<div class="page-shell page-shell--narrow">
  <div class="page-shell__header">
    <h1 class="page-shell__title">{{ 'customer.login.title' | t }}</h1>
  </div>

  <div id="RecoverPassword" class="customer__panel" hidden>
    <h2 class="customer__subtitle">{{ 'customer.recover_password.title' | t }}</h2>
    <p>{{ 'customer.recover_password.subtext' | t }}</p>
    {%- form 'recover_customer_password', class: 'customer__form' -%}
      {%- if form.posted_successfully? -%}
        <p class="form__success" role="status" tabindex="-1" autofocus>{{ 'customer.recover_password.success' | t }}</p>
      {%- endif -%}
      {% render 'form-errors', form: form, id: recover_errors_id %}
      <label for="RecoverEmail">
        {{ 'customer.login.email' | t }}
        <span class="form__required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="RecoverEmail"
        name="email"
        autocomplete="email"
        required
        {%- if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ recover_errors_id }}"{% endif -%}
      >
      {% render 'required-note' %}
      <button type="submit" class="btn btn--primary">{{ 'customer.recover_password.submit' | t }}</button>
      <button type="button" class="btn btn--link" data-toggle-recover>{{ 'customer.recover_password.cancel' | t }}</button>
    {%- endform -%}
  </div>

  <div id="LoginPanel" class="customer__panel">
    {%- form 'customer_login', class: 'customer__form' -%}
      {% render 'form-errors', form: form, id: login_errors_id %}
      <label for="LoginEmail">
        {{ 'customer.login.email' | t }}
        <span class="form__required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="LoginEmail"
        name="customer[email]"
        autocomplete="email"
        required
        {%- if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ login_errors_id }}"{% endif -%}
      >

      <label for="LoginPassword">
        {{ 'customer.login.password' | t }}
        <span class="form__required-mark" aria-hidden="true">*</span>
      </label>
      <input
        type="password"
        id="LoginPassword"
        name="customer[password]"
        autocomplete="current-password"
        required
        {%- if form.errors contains 'password' %} aria-invalid="true" aria-describedby="{{ login_errors_id }}"{% endif -%}
      >

      {% render 'required-note' %}

      <button type="button" class="btn btn--link" data-toggle-recover>{{ 'customer.login.forgot_password' | t }}</button>
      <button type="submit" class="btn btn--primary">{{ 'customer.login.sign_in' | t }}</button>
    {%- endform -%}

    <p class="customer__alt">
      <a href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
    </p>
  </div>

  {%- if shop.checkout.guest_login -%}
    <div class="customer__panel">
      <h2 class="customer__subtitle">{{ 'customer.login.guest_title' | t }}</h2>
      {%- form 'guest_login' -%}
        <button type="submit" class="btn btn--secondary">{{ 'customer.login.guest_continue' | t }}</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    /* Idempotence par racine (meme regle que countdown:323). Sans garde, chaque
       rechargement de section empilait un ecouteur sur document : a la 2e
       execution la bascule « mot de passe oublie » ne faisait plus rien
       (RecoverPassword.hidden true -> true, mesure 1.6.0 ET 1.6.1 : mon lot de
       1.6.1 n'avait pas touche ce fichier). */
    var root = document.getElementById('RecoverPassword');
    if (!root || root.dataset.loginToggleInit === 'true') return;
    root.dataset.loginToggleInit = 'true';
  document.addEventListener('click', function (e) {
    if (!e.target.closest('[data-toggle-recover]')) return;
    var recover = document.getElementById('RecoverPassword');
    var login = document.getElementById('LoginPanel');
    if (!recover || !login) return;
    var showRecover = recover.hidden;
    recover.hidden = !showRecover;
    login.hidden = showRecover;
    (showRecover ? recover : login).querySelector('input')?.focus();
  });
  })();
</script>

{% schema %}
{
  "name": "t:sections.main_customers_login.name",
  "tag": "section",
  "class": "section-customers",
  "settings": []
}
{% endschema %}
