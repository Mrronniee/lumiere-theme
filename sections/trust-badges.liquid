{% comment %}
  Section: Trust badges (Reassurance)
  Arguments de vente avec icone, titre et texte court.
  Les icones sont des SVG inline (aucune dependance au snippet 'icon') et sont
  masquees aux lecteurs d'ecran : le titre porte deja l'information.
  Les separateurs sont des bordures calculees d'apres le nombre de colonnes,
  recalculees a chaque palier responsive pour ne jamais couper une ligne.
{% endcomment %}

{%- liquid
  assign align = section.settings.alignment
  assign flex_align = 'center'
  if align == 'left'
    assign flex_align = 'flex-start'
  elsif align == 'right'
    assign flex_align = 'flex-end'
  endif

  assign columns_desktop = section.settings.columns_desktop
  assign columns_mobile = section.settings.columns_mobile

  assign columns_tablet = columns_desktop
  if columns_tablet > 3
    assign columns_tablet = 3
  endif

  assign show_dividers = section.settings.show_dividers
  assign divider_color = section.settings.text_color | color_modify: 'alpha', 0.18
-%}

{%- style -%}
  .trust-badges {
    padding: var(--spacing-xl) 0;
    background-color: {{ section.settings.background_color }};
  }

  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat({{ columns_desktop }}, minmax(0, 1fr));
    gap: var(--spacing-lg);
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
    list-style: none;
  }

  .trust-badges__item {
    display: flex;
    flex-direction: column;
    align-items: {{ flex_align }};
    text-align: {{ align }};
    gap: var(--spacing-xs);
  }

  .trust-badges__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: {{ section.settings.icon_color }};
  }

  .trust-badges__icon svg {
    display: block;
    width: 32px;
    height: 32px;
  }

  .trust-badges__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.02em;
    color: {{ section.settings.text_color }};
    margin: 0;
  }

  .trust-badges__text {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    max-width: 34ch;
  }

  {%- if show_dividers -%}
    .trust-badges__item {
      border-left: 1px solid {{ divider_color }};
      padding-left: var(--spacing-sm);
      padding-right: var(--spacing-sm);
    }

    .trust-badges__item:nth-child({{ columns_desktop }}n + 1) {
      border-left: 0;
    }
  {%- endif -%}

  @media screen and (max-width: 989px) {
    .trust-badges__grid {
      grid-template-columns: repeat({{ columns_tablet }}, minmax(0, 1fr));
    }

    {%- if show_dividers -%}
      .trust-badges__item {
        border-left: 1px solid {{ divider_color }};
      }

      .trust-badges__item:nth-child({{ columns_tablet }}n + 1) {
        border-left: 0;
      }
    {%- endif -%}
  }

  @media screen and (max-width: 749px) {
    .trust-badges__grid {
      grid-template-columns: repeat({{ columns_mobile }}, minmax(0, 1fr));
      gap: var(--spacing-md);
    }

    .trust-badges__icon svg {
      width: 28px;
      height: 28px;
    }

    {%- if show_dividers -%}
      .trust-badges__item {
        border-left: 0;
        border-top: 1px solid {{ divider_color }};
        padding-left: 0;
        padding-right: 0;
        padding-top: var(--spacing-md);
      }

      .trust-badges__item:nth-child(-n + {{ columns_mobile }}) {
        border-top: 0;
        padding-top: 0;
      }
    {%- endif -%}
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="trust-badges" data-section-id="{{ section.id }}">
    <ul class="trust-badges__grid" role="list" aria-label="{{ 'sections.trust_badges.aria_label' | t }}">
      {%- for block in section.blocks -%}
        <li class="trust-badges__item" {{ block.shopify_attributes }}>
          <span class="trust-badges__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'shield' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M12 2.5 4.5 5.8v5.7c0 4.4 3 8.1 7.5 10 4.5-1.9 7.5-5.6 7.5-10V5.8L12 2.5z"/><path d="m9 11.8 2.1 2.1 4.1-4.1"/></svg>
              {%- when 'refresh' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M20.5 12a8.5 8.5 0 1 1-2.49-6.01"/><polyline points="20.5 3 20.5 8.5 15 8.5"/></svg>
              {%- when 'lock' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/></svg>
              {%- when 'gift' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="11" width="18" height="10" rx="1"/><rect x="2.5" y="7" width="19" height="4" rx="1"/><path d="M12 7v14"/><path d="M12 7S10.6 3 8.6 3a2.5 2.5 0 0 0 0 5H12z"/><path d="M12 7s1.4-4 3.4-4a2.5 2.5 0 0 1 0 5H12z"/></svg>
              {%- when 'leaf' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.5 19 2c1 2 2 4.2 2 8 0 5.5-4.8 10-10 10z"/><path d="M2 21c0-3 1.9-5.4 5.1-6C9.5 14.5 12 13 13 12"/></svg>
              {%- when 'headset' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 16v-4a8 8 0 0 1 16 0v4"/><path d="M4 16a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2z"/><path d="M20 16a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2z"/><path d="M17 20a2 2 0 0 1-2 2h-2"/></svg>
              {%- when 'star' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><polygon points="12 2.5 15 8.7 21.8 9.7 16.9 14.4 18.1 21.2 12 18 5.9 21.2 7.1 14.4 2.2 9.7 9 8.7 12 2.5"/></svg>
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="1.5" y="5" width="12.5" height="11" rx="1"/><path d="M14 9h3.6l2.9 3v4H14V9z"/><circle cx="6" cy="19" r="2"/><circle cx="17" cy="19" r="2"/><path d="M8 19h7"/></svg>
            {%- endcase -%}
          </span>

          {%- if block.settings.title != blank -%}
            <h2 class="trust-badges__title">{{ block.settings.title | escape }}</h2>
          {%- endif -%}

          {%- if block.settings.text != blank -%}
            <p class="trust-badges__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.trust_badges.name",
  "tag": "section",
  "class": "section-trust-badges",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.trust_badges.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.trust_badges.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.trust_badges.settings.columns_mobile.label"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.trust_badges.settings.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.trust_badges.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.trust_badges.settings.alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.trust_badges.settings.alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_dividers",
      "default": false,
      "label": "t:sections.trust_badges.settings.show_dividers.label",
      "info": "t:sections.trust_badges.settings.show_dividers.info"
    },
    {
      "type": "header",
      "content": "t:sections.trust_badges.settings.header__2.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.trust_badges.settings.background_color.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.trust_badges.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:sections.trust_badges.settings.icon_color.label",
      "default": "#1a1a1a"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:sections.trust_badges.blocks.item.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.trust_badges.blocks.item.settings.icon.label",
          "options": [
            {
              "value": "truck",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__1.label"
            },
            {
              "value": "shield",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__2.label"
            },
            {
              "value": "refresh",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__3.label"
            },
            {
              "value": "lock",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__4.label"
            },
            {
              "value": "gift",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__5.label"
            },
            {
              "value": "leaf",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__6.label"
            },
            {
              "value": "headset",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__7.label"
            },
            {
              "value": "star",
              "label": "t:sections.trust_badges.blocks.item.settings.icon.options__8.label"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.trust_badges.blocks.item.settings.title.label",
          "default": "Livraison offerte"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.trust_badges.blocks.item.settings.text.label",
          "default": "Expédition gratuite dès 100 € d'achat."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.trust_badges.presets.name",
      "category": "Text",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Livraison offerte",
            "text": "Expédition gratuite dès 100 € d'achat."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "refresh",
            "title": "Retours sous 30 jours",
            "text": "Changez d'avis, on s'occupe du reste."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "lock",
            "title": "Paiement sécurisé",
            "text": "Transactions chiffrées et protégées."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "headset",
            "title": "Conseil personnalisé",
            "text": "Notre équipe vous répond du lundi au vendredi."
          }
        }
      ]
    }
  ]
}
{% endschema %}
