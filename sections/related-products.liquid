{% comment %}
  Section: Produits associés
{% endcomment %}

{%- style -%}
  .related-products {
    padding: var(--spacing-xl) 0;
    background-color: {{ section.settings.color_scheme.settings.background }};
    {% render 'section-tokens', bg: section.settings.color_scheme.settings.background, text: section.settings.color_scheme.settings.text, accent: section.settings.color_scheme.settings.accent %}
  }

  .related-products__header {
    text-align: center;
    margin-bottom: var(--spacing-lg);
    padding: 0 var(--container-padding);
  }

  .related-products__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  @media screen and (max-width: 989px) {
    .related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .related-products__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }
{%- endstyle -%}

{%- assign related_collection = collections[section.settings.collection] -%}

<div class="related-products color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="related-products__header">
    <h2 class="related-products__title">
      {%- if section.settings.title != blank -%}
        {{- section.settings.title -}}
      {%- else -%}
        {{- 'sections.related_products.default_title' | t -}}
      {%- endif -%}
    </h2>
  </div>

  {%- if related_collection != blank -%}
    <div class="related-products__grid">
      {%- for product in related_collection.products limit: section.settings.products_to_show -%}
        {%- liquid
          comment
            La valeur se calcule AVANT le render : une comparaison n'est pas une
            valeur d'argument en Liquid, et Shopify rejette toute la section au
            push (« Expected end_of_string but found comparison »).
          endcomment
          comment
            Les recommandations sont mesurees a y=1905, soit 2,3 ecrans sous la
            ligne de flottaison : ni chargement immediat ni priorite haute, la
            bande passante doit servir le premier ecran.
          endcomment
          assign card_lazy = true
          assign card_priority = false
        -%}
        {% render 'product-card',
          product: product,
          show_vendor: section.settings.show_vendor,
          lazy: card_lazy,
          priority: card_priority,
          columns_mobile: section.settings.columns_mobile
        %}
      {%- endfor -%}
    </div>
  {%- else -%}
    {%- comment -%}
      API de recommandations Shopify : reellement lie au produit courant.
      La grille PORTE data-recommendations (avant, le conteneur etait une
      simple cellule de la grille : les cartes ramenees se rangeaient en une
      seule colonne), et elle est remplie de cartes d'attente au rendu
      serveur : la place est reservee, le pied de page ne saute plus.
    {%- endcomment -%}
    <div
      class="related-products__grid"
      data-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent | default: 'related' }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products -%}
          {%- liquid
            assign card_lazy = true
            assign card_priority = false
          -%}
          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            lazy: card_lazy,
            priority: card_priority,
            columns_mobile: section.settings.columns_mobile
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {% render 'product-card-skeleton' %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.related_products.name",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.related_products.settings.intent.label",
      "info": "t:sections.related_products.settings.intent.info",
      "options": [
        {
          "value": "related",
          "label": "t:sections.related_products.settings.intent.options__1.label"
        },
        {
          "value": "complementary",
          "label": "t:sections.related_products.settings.intent.options__2.label"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.related_products.settings.title.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.related_products.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "t:sections.related_products.settings.products_to_show.label"
    },
    {
      "type": "select",
      "id": "show_vendor",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.related_products.settings.show_vendor.options__inherit"
        },
        {
          "value": "yes",
          "label": "t:sections.related_products.settings.show_vendor.options__yes"
        },
        {
          "value": "no",
          "label": "t:sections.related_products.settings.show_vendor.options__no"
        }
      ],
      "default": "inherit",
      "label": "t:sections.related_products.settings.show_vendor.label",
      "info": "t:sections.related_products.settings.show_vendor.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings_schema.couleurs.settings.color_scheme.label",
      "info": "t:settings_schema.couleurs.settings.color_scheme.info",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.related_products.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.related_products.settings.columns_tablet.label"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.related_products.settings.columns_mobile.label"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "t:sections.related_products.settings.grid_gap.label"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.related_products.settings.grid_gap_mobile.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.related_products.presets.complementary.name",
      "settings": {
        "intent": "complementary"
      }
    },
    {
      "name": "t:sections.related_products.presets.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
