{% comment %}
  Section: Footer
  Footer multi-colonnes avec liens, newsletter, réseaux sociaux
{% endcomment %}

{%- liquid
  comment
    Encre atténuée du pied : les `opacity` (0,7 sur la description et les
    liens, 0,5 sur le copyright) tombaient sous 4,5:1 des que le marchand
    choisissait un fond clair. On melange le texte vers le fond jusqu'a
    atteindre 4,5:1, comme --color-text-light dans css-variables.
    Seuil 4,6 et non 4,5 : color_contrast arrondit au dixieme, et un 4,5
    annonce valait 4,49 au pixel sur la palette inverse (mesure 1.9.2).
  endcomment
  assign footer_bg = section.settings.color_scheme.settings.background
  assign footer_text = section.settings.color_scheme.settings.text
  assign muted_weight = 55
  assign footer_muted = footer_text | color_mix: footer_bg, muted_weight
  for i in (1..15)
    assign ratio = footer_muted | color_contrast: footer_bg
    if ratio >= 4.6
      break
    endif
    assign muted_weight = muted_weight | plus: 3
    assign footer_muted = footer_text | color_mix: footer_bg, muted_weight
  endfor
-%}

{%- style -%}
  .footer {
    background-color: {{ section.settings.color_scheme.settings.background }};
    {% render 'section-tokens', bg: section.settings.color_scheme.settings.background, text: section.settings.color_scheme.settings.text, accent: section.settings.color_scheme.settings.accent, scheme: section.settings.color_scheme %}
    color: {{ section.settings.color_scheme.settings.text }};
    padding: var(--spacing-xl) 0 var(--spacing-md);
  }

  .footer__inner {
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--container-padding);
  }

  .footer__top {
    display: grid;
    {%- assign extra_columns = section.blocks.size | minus: 1 | at_least: 1 -%}
    grid-template-columns: 2fr repeat({{ extra_columns }}, 1fr);
    gap: var(--spacing-lg);
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid {{ section.settings.color_scheme.settings.border }};
  }

  .footer__brand {
    max-width: 320px;
  }

  .footer__logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 400;
    margin-bottom: var(--spacing-sm);
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .footer__description {
    font-family: var(--font-body);
    font-size: 0.875rem;
    line-height: 1.7;
    color: {{ footer_muted }};
    margin-bottom: var(--spacing-md);
  }

  .footer__socials {
    display: flex;
    gap: var(--spacing-sm);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid {{ section.settings.color_scheme.settings.border }};
    color: {{ section.settings.color_scheme.settings.text }};
    transition: opacity var(--transition-fast), transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  /* L'encre du survol est derivee de l'accent (--color-on-accent) : du blanc
     en dur donnait 2,0:1 sur l'accent par defaut #c9a96e. */
  .footer__social-link:hover {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .footer__column-title {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: var(--spacing-md);
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer__link {
    display: block;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: {{ footer_muted }};
    text-decoration: none;
    padding: 0.35rem 0;
    transition: color var(--transition-fast);
  }

  .footer__link:hover {
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--spacing-md);
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .footer__copyright {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: {{ footer_muted }};
  }

  .footer__payments {
    display: flex;
    gap: 0.5rem;
    align-items: center;
   margin: 0; padding: 0; list-style: none; }

  .footer__payment-icon {
    height: 24px;
    opacity: 0.6;
  }

  .footer__follow {
    display: flex;
    align-items: center;
  }

  /* Le filtre login_button ne rend RIEN quand la boutique n'est pas eligible
     au canal Shop : le conteneur restait alors dans la page, vide et en
     display:flex (mesure du 25/10/2026 sur la demo, ou la boutique n'a aucun
     moyen de paiement active). Meme garde que le QR de la carte cadeau. */
  .footer__follow:empty {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .footer__top {
      grid-template-columns: repeat(2, 1fr);
    }
    .footer__brand {
      grid-column: span 2;
      max-width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .footer__top {
      grid-template-columns: 1fr;
    }
    .footer__brand {
      grid-column: span 1;
    }
    .footer__bottom {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="footer__inner">
    <div class="footer__top">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- comment -%} Bloc d'application depose par le marchand dans le pied. {%- endcomment -%}
          {%- when '@app' -%}
            <div class="footer__app-block" {{ block.shopify_attributes }}>
              {% render block %}
            </div>

          {%- when 'brand' -%}
            <div class="footer__brand" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <img
                  src="{{ block.settings.logo | image_url: width: block.settings.logo_width }}"
                  alt="{{ shop.name | escape }}"
                  class="footer__logo-image"
                  width="{{ block.settings.logo_width }}"
                  height="{{ block.settings.logo_width | times: block.settings.logo.height | divided_by: block.settings.logo.width }}"
                  loading="lazy"
                >
              {%- else -%}
                {%- comment -%}
                  Le nom de la boutique dans le pied n'est pas un titre de
                  section : en <h3> il creait un saut h1 -> h3 sur toutes les
                  pages dont le contenu principal n'a pas de h2.
                {%- endcomment -%}
                <p class="footer__logo">{{ shop.name }}</p>
              {%- endif -%}

              {%- if block.settings.description != blank -%}
                <p class="footer__description">{{ block.settings.description | escape }}</p>
              {%- elsif request.design_mode -%}
                <p class="footer__column-empty">{{ 'sections.footer.brand_needs_description' | t }}</p>
              {%- endif -%}

              <div class="footer__socials">
                {%- if settings.social_instagram != blank -%}
                  <a href="{{ settings.social_instagram }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'accessibility.social_link' | t: name: 'Instagram' }} {{ 'accessibility.new_window' | t }}">
                    {% render 'icon', icon: 'instagram' %}
                  </a>
                {%- endif -%}
                {%- if settings.social_facebook != blank -%}
                  <a href="{{ settings.social_facebook }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'accessibility.social_link' | t: name: 'Facebook' }} {{ 'accessibility.new_window' | t }}">
                    <svg class="icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_pinterest != blank -%}
                  <a href="{{ settings.social_pinterest }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'accessibility.social_link' | t: name: 'Pinterest' }} {{ 'accessibility.new_window' | t }}">
                    <svg class="icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 12a4 4 0 1 0 8 0 4 4 0 1 0-8 0"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
                  </a>
                {%- endif -%}
                {%- if settings.social_tiktok != blank -%}
                  <a href="{{ settings.social_tiktok }}" class="footer__social-link" target="_blank" rel="noopener" aria-label="{{ 'accessibility.social_link' | t: name: 'TikTok' }} {{ 'accessibility.new_window' | t }}">
                    <svg class="icon" aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                  </a>
                {%- endif -%}
              </div>
            </div>

          {%- when 'link_list' -%}
            {%- comment -%}
              Sans menu choisi, toute la colonne disparait : avant, le titre
              s'affichait seul, au-dessus du vide. Le repli du titre passe par
              les locales : le defaut du schema etait de l'anglais en dur, qui
              s'affichait tel quel sur la version francaise.
            {%- endcomment -%}
            {%- if block.settings.menu != blank -%}
              {%- comment -%}
                <nav> et non <div> : c'est un groupe de liens de navigation, et
                le pied n'en mettait aucun dans un repere (axe region /
                landmark-*, cas reperes-de-page du lot 3). La colonne elle-meme
                porte le repere : pas de boite en plus, donc pas un pixel de
                mise en page change. Son nom vient du titre deja affiche, par
                aria-labelledby, pour que deux colonnes se distinguent.
              {%- endcomment -%}
              <nav class="footer__column" aria-labelledby="FooterColumnTitle-{{ block.id }}" {{ block.shopify_attributes }}>
                <p class="footer__column-title" id="FooterColumnTitle-{{ block.id }}">
                  {%- if block.settings.title != blank -%}
                    {{- block.settings.title | escape -}}
                  {%- else -%}
                    {{- 'general.footer.quick_links' | t -}}
                  {%- endif -%}
                </p>
                <ul class="footer__links">
                  {%- for link in block.settings.menu.links -%}
                    <li>
                      <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                </ul>
              </nav>
            {%- elsif request.design_mode -%}
              <div class="footer__column" {{ block.shopify_attributes }}>
                <p class="footer__column-empty">{{ 'sections.footer.column_needs_menu' | t }}</p>
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {% if section.settings.copyright_text != blank %}{{ section.settings.copyright_text }}{% else %}{{ 'general.footer.rights_reserved' | t }}{% endif %}
      </p>
      {%- comment -%}
        FOLLOW ON SHOP. Exigence du Theme Store : la vitrine offre au visiteur de
        suivre la boutique dans l'application Shop. Le filtre login_button rend
        le bouton de Shopify, qui porte son propre libelle et sa propre
        traduction : rien a traduire ici. Derriere un reglage, et decoche par
        defaut, parce qu'il ne convient pas a toutes les marques.
      {%- endcomment -%}
      {%- if section.settings.show_follow_on_shop -%}
        <div class="footer__follow">{{ shop | login_button: action: 'follow' }}</div>
      {%- endif -%}
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list" aria-label="{{ 'general.payment.methods' | t }}">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "tag": "section",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings_schema.couleurs.settings.color_scheme.label",
      "info": "t:settings_schema.couleurs.settings.color_scheme.info",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:sections.footer.settings.show_payment_icons.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:sections.footer.settings.show_follow_on_shop.label",
      "info": "t:sections.footer.settings.show_follow_on_shop.info",
      "default": false
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "t:sections.footer.settings.copyright_text.label"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.footer.blocks.brand.settings.logo.label"
        },
        {
          "type": "range",
          "id": "logo_width",
          "min": 50,
          "max": 250,
          "step": 10,
          "default": 150,
          "unit": "px",
          "label": "t:sections.footer.blocks.brand.settings.logo_width.label"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.footer.blocks.brand.settings.description.label",
          "info": "t:sections.footer.blocks.brand.settings.description.info"
        }
      ]
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.footer.blocks.link_list.settings.title.label",
          "info": "t:sections.footer.blocks.link_list.settings.title.info"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "default": "footer"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "brand"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
