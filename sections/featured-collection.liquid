{% comment %}
  Section: Collection mise en avant
  Affiche une grille de produits d'une collection sélectionnée
  Avec filtres et animations au scroll
{% endcomment %}

{%- style -%}
  .featured-collection {
    padding: var(--spacing-xl) 0;
    background-color: {{ section.settings.color_scheme.settings.background }};
    {% render 'section-tokens', bg: section.settings.color_scheme.settings.background, text: section.settings.color_scheme.settings.text, accent: section.settings.color_scheme.settings.accent, scheme: section.settings.color_scheme %}
  }

  .featured-collection__header {
    text-align: {{ section.settings.text_alignment }};
    margin-bottom: var(--spacing-lg);
    padding: 0 var(--container-padding);
  }

  .featured-collection__pretitle {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--spacing-xs);
  }

  .featured-collection__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.color_scheme.settings.text }};
    margin-bottom: var(--spacing-sm);
  }

  .featured-collection__description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-light);
    max-width: 600px;
    margin: 0 auto;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    padding: 0 var(--container-padding);
    max-width: var(--container-width);
    margin: 0 auto;
  }

  .featured-collection__product {
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  /* La garde .animations-on manquait : les cartes restaient a opacite 0 meme
     quand le marchand a coupe les animations ou quand le visiteur demande
     moins de mouvement, et un element a opacite 0 n'est jamais candidat LCP —
     la priorite haute posee sur la premiere carte etait donc perdue. */
  .js.animations-on .featured-collection__product[data-animate] {
    opacity: 0;
    transform: translateY(30px);
  }

  .js.animations-on .featured-collection__product.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .featured-collection__footer {
    text-align: center;
    margin-top: var(--spacing-lg);
    padding: 0 var(--container-padding);
  }

  .featured-collection__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    background-color: {{ section.settings.color_scheme.settings.primary_button }};
    color: {{ section.settings.color_scheme.settings.on_primary_button }};
    border: 1px solid {{ section.settings.color_scheme.settings.primary_button }};
    transition: opacity var(--transition-base), transform var(--transition-base), background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }

  .featured-collection__button:hover {
    background-color: {{ section.settings.color_scheme.settings.primary_button | color_darken: 10 }};
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  @media screen and (max-width: 989px) {
    .featured-collection__grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .featured-collection__grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="featured-collection color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="featured-collection__header">
    <p class="featured-collection__pretitle">{%- if section.settings.pretitle != blank -%}{{ section.settings.pretitle | escape }}{%- else -%}{{ 'sections.featured_collection.default_pretitle' | t }}{%- endif -%}</p>

    <h2 class="featured-collection__title">{%- if section.settings.title != blank -%}{{ section.settings.title | escape }}{%- else -%}{{ 'sections.featured_collection.default_title' | t }}{%- endif -%}</h2>

    <p class="featured-collection__description">{%- if section.settings.description != blank -%}{{ section.settings.description | escape }}{%- else -%}{{ 'sections.featured_collection.default_description' | t }}{%- endif -%}</p>
  </div>

  {%- assign collection = collections[section.settings.collection] -%}

  {%- if collection != blank -%}
    <div class="featured-collection__grid">
      {%- for product in collection.products limit: section.settings.products_to_show -%}
        {%- comment -%}
          Pas de fondu sur la premiere rangee : quand la section ouvre la page,
          une carte a opacite 0 n'est peinte qu'apres le fondu, et l'une d'elles
          est l'element LCP en mobile.
        {%- endcomment -%}
        <div class="featured-collection__product"{% if forloop.index > 4 %} data-animate{% endif %}>
          {%- comment -%}
            Les premieres cartes sont au-dessus de la ligne de flottaison et
            l'une d'elles est l'element LCP en mobile : chargement immediat, la
            premiere en priorite. Sans ces arguments, product-card retombait
            sur loading="lazy" pour toutes (LCP retarde d'environ 0,8 a 1 s).
          {%- endcomment -%}
          {%- liquid
            comment
              La valeur se calcule AVANT le render : une comparaison n'est pas
              une valeur d'argument en Liquid, et Shopify rejette toute la
              section au push (« Expected end_of_string but found comparison »).
            endcomment
            comment
              Chargement immediat et priorite haute SEULEMENT si la section peut
              etre dans le premier ecran : mesure sur la demo, les 4 cartes
              sortaient en eager (la premiere en fetchpriority=high) alors
              qu'elles sont a y=819 pour une fenetre de 823 et revelees au
              defilement (opacite 0) — un element a opacite 0 n'est de toute
              facon jamais candidat LCP, la priorite etait perdue.
            endcomment
            comment
              1.6.2 : « section.index <= 2 » laissait encore 4 cartes en eager alors que
              la section est 2e du gabarit d'accueil et commence a y=819 pour une
              fenetre de 823 (mesure 1.6.1 : 0 image au premier ecran a 1350, 4 eager
              hors ecran). Seule une section REELLEMENT premiere peut etre peinte
              dans le premier ecran.
            endcomment
            assign card_lazy = true
            if section.index == 1 and forloop.index <= 4
              assign card_lazy = false
            endif
            assign card_priority = false
            if section.index == 1 and forloop.first
              assign card_priority = true
            endif
          -%}
          {% render 'product-card',
            product: product,
            show_vendor: section.settings.show_vendor,
            lazy: card_lazy,
            priority: card_priority,
            columns_mobile: section.settings.columns_mobile
          %}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="featured-collection__footer">
        <a href="{{ collection.url }}" class="featured-collection__button">
          {%- if section.settings.view_all_label != blank -%}
            {{ section.settings.view_all_label }}
          {%- else -%}
            {{ 'collections.general.view_all' | t }}
          {%- endif -%}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="featured-collection__grid">
      {%- assign placeholder_count = section.settings.products_to_show | at_most: 6 -%}
      {%- for i in (1..placeholder_count) -%}
        {%- comment -%}
          Pas de fondu sur la premiere rangee : quand la section ouvre la page,
          une carte a opacite 0 n'est peinte qu'apres le fondu, et l'une d'elles
          est l'element LCP en mobile.
        {%- endcomment -%}
        <div class="featured-collection__product"{% if forloop.index > 4 %} data-animate{% endif %}>
          <div class="product-card product-card--placeholder">
            <div class="product-card__media">
              <span class="placeholder-wrap" aria-hidden="true">{{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</span>
            </div>
            <div class="product-card__info">
              <span class="product-card__placeholder-line"></span>
              <span class="product-card__placeholder-line product-card__placeholder-line--short"></span>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "pretitle",
      "label": "t:sections.featured_collection.settings.pretitle.label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.featured_collection.settings.title.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.featured_collection.settings.description.label"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.featured_collection.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.products_to_show.label"
    },
    {
      "type": "select",
      "id": "show_vendor",
      "options": [
        {
          "value": "inherit",
          "label": "t:sections.featured_collection.settings.show_vendor.options__inherit"
        },
        {
          "value": "yes",
          "label": "t:sections.featured_collection.settings.show_vendor.options__yes"
        },
        {
          "value": "no",
          "label": "t:sections.featured_collection.settings.show_vendor.options__no"
        }
      ],
      "default": "inherit",
      "label": "t:sections.featured_collection.settings.show_vendor.label",
      "info": "t:sections.featured_collection.settings.show_vendor.info"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "t:sections.featured_collection.settings.show_view_all.label",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:sections.featured_collection.settings.view_all_label.label"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__2.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings_schema.couleurs.settings.color_scheme.label",
      "info": "t:settings_schema.couleurs.settings.color_scheme.info",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.featured_collection.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.featured_collection.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.featured_collection.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.featured_collection.settings.text_alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.settings.header__3.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured_collection.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.featured_collection.settings.columns_tablet.label"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.featured_collection.settings.columns_mobile.label"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.grid_gap.label"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.featured_collection.settings.grid_gap_mobile.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.presets.name",
      "category": "t:categories.collection"
    }
  ]
}
{% endschema %}
