{% comment %}
  Section: Newsletter
  Inscription newsletter stylisée avec animation
{% endcomment %}

{%- liquid
  comment
    Le bord du champ porte une information : 3:1 exige (WCAG 1.4.11). La
    couleur choisie par le marchand est relevee juste ce qu'il faut sur le
    fond de la section — #e0e0e0 par defaut mesurait 1,21:1.
  endcomment
  capture input_border
    render 'contrast-color', base: section.settings.input_border, bg: section.settings.background_color, target: 3
  endcapture
  assign input_border = input_border | strip

  comment
    L'APLAT DU CHAMP ET SON ENCRE SONT DEUX REGLAGES INDEPENDANTS ici
    (input_bg et text_color) : le marchand peut donc poser un texte clair sur
    un champ clair. Mesure de l'audit d'accessibilite 1.8.1 : meme patron que
    les 4 champs de contact a 1,00:1. L'encre du champ se derive donc sur
    l'aplat du champ, en gardant la teinte choisie, comme input_border ci-dessus.
  endcomment
  capture input_text
    render 'contrast-color', base: section.settings.text_color, bg: section.settings.input_bg
  endcapture
  assign input_text = input_text | strip
-%}

{%- style -%}
  .newsletter {
    padding: var(--spacing-xl) var(--container-padding);
    background-color: {{ section.settings.background_color }};
    {% render 'section-tokens', bg: section.settings.background_color, text: section.settings.text_color %}
    text-align: center;
  }

  .newsletter__inner {
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter__pretitle {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-text);
    margin-bottom: var(--spacing-xs);
  }

  .newsletter__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 400;
    line-height: 1.2;
    color: {{ section.settings.text_color }};
    margin-bottom: var(--spacing-sm);
  }

  .newsletter__description {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  .newsletter__form {
    display: flex;
    gap: var(--spacing-xs);
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter__input {
    flex: 1;
    padding: 1rem 1.5rem;
    font-family: var(--font-body);
    font-size: 1rem;
    border: 1px solid {{ input_border }};
    background-color: {{ section.settings.input_bg }};
    color: {{ input_text }};
    transition: border-color var(--transition-fast);
  }

  .newsletter__input::placeholder {
    color: var(--color-text-light);
  }

  .newsletter__input:focus {
    border-color: var(--color-accent);
  }

  .newsletter__button {
    padding: 1rem 2rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text }};
    border: none;
    cursor: pointer;
    transition: opacity var(--transition-base), transform var(--transition-base), background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base);
    white-space: nowrap;
  }

  .newsletter__button:hover {
    background-color: {{ section.settings.button_bg | color_darken: 10 }};
    transform: translateY(-1px);
  }

  .newsletter__disclaimer {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-text-light);
    /* 0.5 donnait 3,25:1 (Lighthouse) : 0.8 reste au-dessus de 4,5:1 */
    margin-top: var(--spacing-sm);
  }

  @media screen and (max-width: 749px) {
    .newsletter__form {
      flex-direction: column;
      /* En colonne, le champ se retrouve juste au-dessus du bouton, dont le fond
         est --color-primary. Avec le gap de --spacing-xs (8 px), l'anneau de
         focus du champ (2 px d'ombre + 2 px de contour) et le pixel de controle
         pris 2 px plus loin tombaient sur le bord du bouton : contour sombre
         contre fond sombre, 1:1 sur le bord bas, alors que les trois autres
         cotes valaient 15,96:1 (mesure du 23/10/2026, accueil en 390). Le gap
         degage l'anneau sur le fond de la section. */
      gap: var(--spacing-sm);
    }
    .newsletter__button {
      width: 100%;
    }
  }
{%- endstyle -%}

{%- assign newsletter_errors_id = 'NewsletterErrors-' | append: section.id -%}
<div class="newsletter" data-section-id="{{ section.id }}">
  <div class="newsletter__inner">
    <p class="newsletter__pretitle">{%- if section.settings.pretitle != blank -%}{{ section.settings.pretitle | escape }}{%- else -%}{{ 'sections.newsletter.default_pretitle' | t }}{%- endif -%}</p>

    <h2 class="newsletter__title">{%- if section.settings.title != blank -%}{{ section.settings.title | escape }}{%- else -%}{{ 'sections.newsletter.default_title' | t }}{%- endif -%}</h2>

    <p class="newsletter__description">{%- if section.settings.description != blank -%}{{ section.settings.description | escape }}{%- else -%}{{ 'sections.newsletter.default_description' | t }}{%- endif -%}</p>

    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">{{ 'newsletter.email_label' | t }}</label>
      <input
        type="email"
        id="NewsletterEmail-{{ section.id }}"
        name="contact[email]"
        class="newsletter__input"
        value="{{ form.email }}"
        aria-required="true"
        autocorrect="off"
        autocapitalize="off"
        autocomplete="email"
        placeholder="{% if section.settings.placeholder != blank %}{{ section.settings.placeholder | escape }}{% else %}{{ 'sections.newsletter.default_placeholder' | t }}{% endif %}"
        required
        {%- if form.errors %} aria-invalid="true" aria-describedby="{{ newsletter_errors_id }}"{% endif -%}
      >
      <button type="submit" class="newsletter__button" name="commit">
        {%- if section.settings.button_label != blank -%}{{ section.settings.button_label | escape }}{%- else -%}{{ 'sections.newsletter.default_button' | t }}{%- endif -%}
      </button>

      {%- if form.posted_successfully? -%}
        <div class="newsletter__success" role="status" tabindex="-1" autofocus>
          {% render 'icon', icon: 'check' %}
          <span>{{ 'newsletter.success' | t }}</span>
        </div>
      {%- elsif form.errors -%}
        <div
          id="{{ newsletter_errors_id }}"
          class="newsletter__error"
          role="alert"
          tabindex="-1"
          autofocus
        >
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}
    {%- endform -%}

    {%- comment -%} Blocs d'application (formulaire d'une app d'e-mailing...). {%- endcomment -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        <div class="newsletter__app-block" {{ block.shopify_attributes }}>
          {% render block %}
        </div>
      {%- endif -%}
    {%- endfor -%}

    <p class="newsletter__disclaimer">{%- if section.settings.disclaimer != blank -%}{{ section.settings.disclaimer | escape }}{%- else -%}{{ 'sections.newsletter.default_disclaimer' | t }}{%- endif -%}</p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__1.content"
    },
    {
      "type": "text",
      "id": "pretitle",
      "label": "t:sections.newsletter.settings.pretitle.label"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:sections.newsletter.settings.title.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.newsletter.settings.description.label"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:sections.newsletter.settings.placeholder.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter.settings.button_label.label"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "t:sections.newsletter.settings.disclaimer.label"
    },
    {
      "type": "header",
      "content": "t:sections.newsletter.settings.header__2.content"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.newsletter.settings.background_color.label",
      "default": "#f5f5f5"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.newsletter.settings.text_color.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "input_bg",
      "label": "t:sections.newsletter.settings.input_bg.label",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_border",
      "label": "t:sections.newsletter.settings.input_border.label",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "t:sections.newsletter.settings.button_bg.label",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "button_text",
      "label": "t:sections.newsletter.settings.button_text.label",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name",
      "category": "t:categories.promotional"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
