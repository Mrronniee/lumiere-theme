{% comment %}
  Section: Grille Collection avec Filtres
  Filtres côté client sans rechargement de page
{% endcomment %}

{%- style -%}
  .collection-grid {
    padding: var(--spacing-lg) 0;
    max-width: var(--container-width);
    margin: 0 auto;
    padding-left: var(--container-padding);
    padding-right: var(--container-padding);
  }

  .collection-grid__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .collection-grid__count {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  .collection-grid__controls {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
    align-items: center;
    min-width: 0;
    max-width: 100%;
  }

  .collection-grid__filter-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--color-background);
  }

  .collection-grid__sort {
    padding: 0.75rem 2rem 0.75rem 1rem;
    border: 1px solid var(--color-border-strong, var(--color-border));
    font-family: var(--font-body);
    font-size: 1rem;
    background: var(--color-background);
    /* L'ENCRE MANQUAIT. Sans « color », le texte du select restait le noir par
       defaut du navigateur, pose sur l'aplat de la palette : « Alphabetically,
       A-Z » mesurait 1,21:1 sur une palette sombre (audit d'accessibilite
       1.8.1). L'encre vient donc de la meme source que l'aplat. */
    color: var(--color-text);
    appearance: none;
    /* Fleche derivee sur l'aplat du champ (snippets/css-variables) : son
       stroke etait fige a #333, invisible sur un champ sombre. */
    background-image: var(--select-arrow);
    background-repeat: no-repeat;
    background-position: right 0.75rem center;
    min-width: 0;
    max-width: 100%;
  }

  .collection-grid__layout {
    display: flex;
    gap: 0.25rem;
  }

  .collection-grid__layout-btn {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    transition: opacity var(--transition-fast), transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .collection-grid__layout-btn.is-active {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  /* ===== FILTRES ===== */
  .collection-grid__body {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--spacing-lg);
  }

  /* Sans filtres configures, pas de colonne vide de 260px */
  .collection-grid__body--no-filters { grid-template-columns: 1fr; }

  .collection-filters {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .collection-filters__overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.5);
    z-index: calc(var(--z-drawer) - 1);
  }

  .collection-filters__close {
    display: none;
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  .collection-filters__group {
    margin-bottom: var(--spacing-md);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--spacing-md);
  }

  .collection-filters__title {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-sm);
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
  }

  .collection-filters__title svg {
    transition: transform var(--transition-fast);
  }

  .collection-filters__group.is-collapsed .collection-filters__title svg {
    transform: rotate(-90deg);
  }

  .collection-filters__options {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .collection-filters__group.is-collapsed .collection-filters__options {
    display: none;
  }

  .collection-filters__option {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-light);
    transition: color var(--transition-fast);
  }

  .collection-filters__option:hover {
    color: var(--color-primary);
  }

  /* 24 x 24 px : cible tactile minimale (WCAG 2.5.8, Theme Store). */
  .collection-filters__option input {
    width: 24px;
    height: 24px;
    accent-color: var(--color-primary);
    cursor: pointer;
  }

  .collection-filters__option-count {
    margin-left: auto;
    font-size: 0.75rem;
  }

  .collection-filters__swatch {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .collection-filters__option input:checked ~ .collection-filters__swatch {
    border-color: var(--color-primary);
  }

  .collection-filters__price-range {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .collection-filters__price-input {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid var(--color-border-strong, var(--color-border));
    font-family: var(--font-body);
    font-size: 1rem;
  }

  .collection-filters__active {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: var(--spacing-md);
  }

  .collection-filters__active-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-size: 0.75rem;
    font-family: var(--font-body);
    text-decoration: none;
  }

  .collection-filters__active-clear {
    padding: 0.4rem 0.75rem;
    font-size: 0.75rem;
    font-family: var(--font-body);
    text-decoration: underline;
    color: var(--color-text-light);
  }

  /* ===== GRILLE PRODUITS ===== */
  .collection-grid__products {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
  }

  .collection-grid__products--list {
    grid-template-columns: 1fr;
  }

  .collection-grid__products--list .product-card {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: var(--spacing-md);
  }

  .collection-grid__products--list .product-card__media {
    aspect-ratio: 1;
  }

  .collection-grid__pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: var(--spacing-lg);
  }

  .collection-grid__pagination a,
  .collection-grid__pagination span {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    font-family: var(--font-body);
    font-size: 0.875rem;
    border: 1px solid var(--color-border);
    transition: opacity var(--transition-fast), transform var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .collection-grid__pagination a:hover {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .collection-grid__pagination .current {
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-color: var(--color-primary);
  }

  .collection-grid__no-results {
    text-align: center;
    padding: var(--spacing-xl) 0;
  }

  .collection-grid__no-results-title {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    margin-bottom: var(--spacing-sm);
  }

  .collection-grid__no-results-text {
    color: var(--color-text-light);
    margin-bottom: var(--spacing-md);
  }

  @media screen and (max-width: 989px) {
    .collection-grid__body {
      grid-template-columns: 1fr;
    }
    .collection-filters {
      position: fixed;
      top: 0;
      left: 0;
      width: 320px;
      height: 100vh;
      height: 100dvh;
      visibility: hidden;
      background: var(--color-background);
      z-index: var(--z-drawer);
      padding: var(--spacing-lg) var(--spacing-md);
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform var(--transition-base);
    }
    .collection-filters.is-open {
      transform: translateX(0);
      visibility: visible;
    }
    .collection-filters__overlay.is-visible {
      display: block;
    }
    .collection-filters__close {
      display: block;
    }
    .collection-grid__filter-toggle {
      display: flex;
    }
    .collection-grid__products {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .collection-grid__products {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
    .collection-grid__products--list .product-card {
      grid-template-columns: 1fr;
    }
    .collection-grid__controls {
      width: 100%;
    }
    .collection-grid__sort {
      flex: 1 1 8rem;
    }
  }
{%- endstyle -%}

{%- paginate collection.products by section.settings.products_per_page -%}

<div class="collection-grid" data-section-id="{{ section.id }}" data-section-type="collection">
  <div class="collection-grid__header">
    <span class="collection-grid__count">
      {{- 'sections.collection.product_count' | t: count: collection.products_count -}}
    </span>

    <div class="collection-grid__controls">
      {%- if collection.filters.size > 0 -%}
        <button type="button" class="collection-grid__filter-toggle" data-filter-toggle aria-expanded="false" aria-controls="CollectionFilters">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
          {{ 'sections.collection.filters' | t }}
        </button>
      {%- endif -%}

      {%- comment -%}
        Les options de tri viennent de `collection.sort_options` : la liste
        ecrite en dur ne suivait pas les tris reellement actifs de la boutique.
      {%- endcomment -%}
      {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
      {% render 'facet-sort', filterable: collection, section_id: section.id %}

      <div class="collection-grid__layout">
        <button type="button" class="collection-grid__layout-btn is-active" data-layout="grid" aria-pressed="true" aria-label="{{ 'accessibility.grid_view' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        </button>
        <button type="button" class="collection-grid__layout-btn" data-layout="list" aria-pressed="false" aria-label="{{ 'accessibility.list_view' | t }}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="collection-grid__body{% if collection.filters.size == 0 %} collection-grid__body--no-filters{% endif %}">
    {% render 'facet-filters',
      filterable: collection,
      reset_url: collection.url,
      section_id: section.id,
      sort_by: sort_by
    %}

    <div class="collection-grid__products-wrapper">
      {%- if collection.products.size > 0 -%}
        <div class="collection-grid__products" data-products-grid>
          {%- for product in collection.products -%}
            {%- liquid
              comment
                Les premieres cartes sont au-dessus de la ligne de flottaison : chargement
                immediat, la premiere en priorite (Lighthouse : lcp-lazy-loaded).
              endcomment
              assign card_lazy = true
              if forloop.index <= 4
                assign card_lazy = false
              endif
              assign card_priority = forloop.first
            -%}
            {% render 'product-card', product: product, show_vendor: section.settings.show_vendor, heading: 'h2', lazy: card_lazy, priority: card_priority, columns_mobile: section.settings.columns_mobile %}
          {%- endfor -%}
        </div>

        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="collection-grid__no-results">
          <h2 class="collection-grid__no-results-title">{{ 'sections.collection.no_results_title' | t }}</h2>
          <p class="collection-grid__no-results-text">{{ 'sections.collection.no_results_text' | t }}</p>
          <a href="{{ collection.url }}" class="btn btn--primary">{{ 'sections.collection.reset_filters' | t }}</a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{%- endpaginate -%}

{% schema %}
{
  "name": "t:sections.main_collection_product_grid.name",
  "tag": "section",
  "class": "section-collection-grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "t:sections.main_collection_product_grid.settings.products_per_page.label"
    },
    {
      "type": "select",
      "id": "show_vendor",
      "options": [
        { "value": "inherit", "label": "t:sections.main_collection_product_grid.settings.show_vendor.options__inherit" },
        { "value": "yes", "label": "t:sections.main_collection_product_grid.settings.show_vendor.options__yes" },
        { "value": "no", "label": "t:sections.main_collection_product_grid.settings.show_vendor.options__no" }
      ],
      "default": "inherit",
      "label": "t:sections.main_collection_product_grid.settings.show_vendor.label",
      "info": "t:sections.main_collection_product_grid.settings.show_vendor.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection_product_grid.settings.header__1.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main_collection_product_grid.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.main_collection_product_grid.settings.columns_tablet.label"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.main_collection_product_grid.settings.columns_mobile.label"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24,
      "unit": "px",
      "label": "t:sections.main_collection_product_grid.settings.grid_gap.label"
    },
    {
      "type": "range",
      "id": "grid_gap_mobile",
      "min": 8,
      "max": 32,
      "step": 4,
      "default": 16,
      "unit": "px",
      "label": "t:sections.main_collection_product_grid.settings.grid_gap_mobile.label"
    }
  ]
}
{% endschema %}
