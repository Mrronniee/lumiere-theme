{% comment %}
  Section: Main Cart Footer
  Récapitulatif et checkout
{% endcomment %}

{%- style -%}
  .cart-footer {
    padding: var(--spacing-lg) 0 var(--spacing-xl);
    max-width: var(--container-width);
    margin: 0 auto;
    padding-left: var(--container-padding);
    padding-right: var(--container-padding);
  }

  .cart-footer__grid {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: var(--spacing-lg);
  }

  .cart-footer__note {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
  }

  .cart-footer__note-label {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .cart-footer__note-input {
    width: 100%;
    min-height: 120px;
    padding: 1rem;
    border: 1px solid var(--color-border-strong, var(--color-border));
    font-family: var(--font-body);
    font-size: 1rem;
    resize: vertical;
  }

  .cart-footer__summary {
    background: var(--color-surface-3);
    padding: var(--spacing-md);
  }

  .cart-footer__summary-title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: var(--spacing-md);
    padding-bottom: var(--spacing-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-footer__line {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }

  .cart-footer__line--subtotal {
    font-weight: 500;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
  }

  .cart-footer__discount { color: var(--color-sale); }

  .cart-footer__line--total {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 400;
    border-top: 1px solid var(--color-border);
    margin-top: var(--spacing-sm);
    padding-top: var(--spacing-sm);
  }

  .cart-footer__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    padding: 1.25rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-top: var(--spacing-md);
    transition: opacity var(--transition-base), transform var(--transition-base), background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base), box-shadow var(--transition-base);
  }

  .cart-footer__checkout:hover {
    background: var(--color-primary-hover);
  }

  /* Barre « livraison offerte » : meme rendu que dans le tiroir
     (snippets/cart-free-shipping.liquid). */
  .cart-footer__free-shipping {
    padding: var(--spacing-sm);
    background: var(--color-surface-6);
    margin-bottom: var(--spacing-sm);
    text-align: center;
  }

  .cart-footer__free-shipping-text {
    font-family: var(--font-body);
    font-size: 0.8125rem;
  }

  .cart-footer__free-shipping-bar {
    width: 100%;
    height: 4px;
    background: var(--color-surface-16);
    margin-top: 0.5rem;
    overflow: hidden;
  }

  .cart-footer__free-shipping-progress {
    height: 100%;
    background: var(--color-accent);
    transition: width 0.5s ease;
  }

  .cart-footer__note-shipping {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    /* pose sur la surface du recapitulatif, pas sur le fond : 4,37:1 mesure */
    color: var(--color-text-light-surface, var(--color-text-light));
    text-align: center;
    margin-top: var(--spacing-sm);
  }

  @media screen and (max-width: 989px) {
    .cart-footer__grid {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{%- comment -%}
  Conteneur rendu meme panier vide : theme.js le retrouve (data-cart-section)
  pour re-rendre le recapitulatif apres chaque changement de quantite.
{%- endcomment -%}
<div data-cart-section data-section-id="{{ section.id }}">
{%- if cart.item_count > 0 -%}
<div class="cart-footer">
  <div class="cart-footer__grid">
    {%- if settings.cart_show_note -%}
    <div class="cart-footer__note">
      <label for="CartNote" class="cart-footer__note-label">{{ 'cart.general.note' | t }}</label>
      <textarea
        name="note"
        id="CartNote"
        class="cart-footer__note-input"
        placeholder="{{ 'cart.general.note_placeholder' | t }}"
        form="CartForm"
      >{{ cart.note }}</textarea>
    </div>
    {%- endif -%}

    <div class="cart-footer__summary">
      <h2 class="cart-footer__summary-title">{{ 'cart.general.summary' | t }}</h2>

      {% render 'cart-free-shipping', class: 'cart-footer__free-shipping' %}

      {%- comment -%}
        Le sous-total est le total AVANT remises : cart.items_subtotal_price.
        Avec cart.total_price, deja remise, la page affichait « Sous-total
        391,50 - Remises 43,50 = Total 391,50 » et le client ne pouvait pas
        verifier son panier.
      {%- endcomment -%}
      <div class="cart-footer__line cart-footer__line--subtotal">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <span data-cart-subtotal>{% render 'money', amount: cart.items_subtotal_price %}</span>
      </div>

      <div class="cart-footer__line">
        <span>{{ 'cart.general.shipping' | t }}</span>
        <span>{{ 'cart.general.calculated_at_checkout' | t }}</span>
      </div>

      {%- if cart.total_discounts > 0 -%}
        <div class="cart-footer__line">
          <span>{{ 'cart.general.discounts' | t }}</span>
          <span class="cart-footer__discount">&minus;{% render 'money', amount: cart.total_discounts %}</span>
        </div>
      {%- endif -%}

      <div class="cart-footer__line cart-footer__line--total">
        <span>{{ 'cart.general.total' | t }}</span>
        <span data-cart-total>{% render 'money', amount: cart.total_price %}</span>
      </div>

      <p class="cart-footer__note-shipping">{% render 'cart-taxes-note' %}</p>

      <button type="submit" name="checkout" class="cart-footer__checkout" form="CartForm">
        {{ 'cart.general.checkout' | t }}
        {% render 'icon', icon: 'arrow-right' %}
      </button>

      {%- comment -%}
        Boutons de paiement accelere (Shop Pay, PayPal, Apple Pay...). La fiche
        produit les affichait, la page panier non : le client devait passer par
        la commande pour y arriver.
      {%- endcomment -%}
      {%- if additional_checkout_buttons -%}
        <div class="cart-footer__accelerated">
          {{ content_for_additional_checkout_buttons }}
        </div>
      {%- endif -%}

      {%- comment -%} Blocs d'application du panier (financement, assurance...). {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="cart-footer__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.main_cart_footer.name",
  "tag": "section",
  "class": "section-cart-footer",
  "settings": [],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
