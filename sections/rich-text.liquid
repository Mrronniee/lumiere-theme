{% comment %}
  Section: Rich text
  Bloc éditorial centré composé de blocks (pré-titre, titre, texte, bouton)
  Largeur, alignement, couleurs et espacements réglables par le marchand
{% endcomment %}

{%- style -%}
  .rich-text--{{ section.id }} {
    background-color: {{ section.settings.color_scheme.settings.background }};
    {% render 'section-tokens', bg: section.settings.color_scheme.settings.background, text: section.settings.color_scheme.settings.text, accent: section.settings.color_scheme.settings.accent %}
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: var(--container-padding);
    padding-right: var(--container-padding);
  }

  .rich-text--{{ section.id }} .rich-text__inner {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    text-align: {{ section.settings.text_alignment }};
    color: {{ section.settings.color_scheme.settings.text }};
  }

  .rich-text__block + .rich-text__block {
    margin-top: var(--spacing-sm);
  }

  .rich-text__eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-accent-text);
  }

  .rich-text__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 400;
    line-height: 1.2;
    color: inherit;
  }

  .rich-text__text {
    font-family: var(--font-body);
    font-size: 1rem;
    color: inherit;
  }

  .rich-text__text > *:last-child {
    margin-bottom: 0;
  }

  .rich-text__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-xs);
    justify-content: flex-start;
  }

  .rich-text--center .rich-text__buttons {
    justify-content: center;
  }

  .rich-text--right .rich-text__buttons {
    justify-content: flex-end;
  }

  .rich-text__empty {
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-text-light);
  }

  @media screen and (max-width: 989px) {
    .rich-text__heading {
      font-size: clamp(1.5rem, 4vw, 2.25rem);
    }
  }

  @media screen and (max-width: 749px) {
    .rich-text--{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.7 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.7 | round }}px;
    }

    .rich-text__buttons .btn {
      width: 100%;
    }
  }
{%- endstyle -%}

<div
  class="rich-text color-{{ section.settings.color_scheme }} rich-text--{{ section.id }} rich-text--{{ section.settings.text_alignment }}"
  data-section-id="{{ section.id }}"
>
  <div class="rich-text__inner">
    {%- comment -%}
      Mode d'emploi reserve a l'editeur : sans le test request.design_mode il
      s'affichait aux clients (« Add an eyebrow, a heading, text or a
      button... » sur la boutique).
    {%- endcomment -%}
    {%- if section.blocks.size == 0 and request.design_mode -%}
      <p class="rich-text__empty">{{ 'sections.rich_text.no_blocks' | t }}</p>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          {%- if block.settings.text != blank -%}
            <p class="rich-text__block rich-text__eyebrow" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </p>
          {%- endif -%}

        {%- when 'heading' -%}
          {%- if block.settings.text != blank -%}
            {%- liquid
              assign heading_tag = block.settings.heading_tag | default: 'h2'
              unless heading_tag == 'h1' or heading_tag == 'h2' or heading_tag == 'h3'
                assign heading_tag = 'h2'
              endunless
            -%}
            <{{ heading_tag }} class="rich-text__block rich-text__heading" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </{{ heading_tag }}>
          {%- endif -%}

        {%- when 'text' -%}
          {%- if block.settings.text != blank -%}
            <div class="rich-text__block rich-text__text rte" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </div>
          {%- endif -%}

        {%- when 'button' -%}
          {%- comment -%}
            Sans destination choisie, pas de lien : `| default: '#'` rendait un
            bouton qui ramene en haut de la page. L'editeur, lui, est prevenu.
          {%- endcomment -%}
          {%- if block.settings.label != blank and block.settings.link != blank -%}
            {%- assign button_class = 'btn btn--secondary' -%}
            {%- if block.settings.style == 'primary' -%}
              {%- assign button_class = 'btn btn--primary' -%}
            {%- endif -%}
            <div class="rich-text__block rich-text__buttons" {{ block.shopify_attributes }}>
              <a href="{% render 'lien-localise', url: block.settings.link %}" class="{{ button_class }}">
                {{ block.settings.label | escape }}
              </a>
            </div>
          {%- elsif block.settings.label != blank and request.design_mode -%}
            <p class="rich-text__block rich-text__empty" {{ block.shopify_attributes }}>
              {{ 'sections.rich_text.button_needs_link' | t }}
            </p>
          {%- endif -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich_text.name",
  "tag": "section",
  "class": "section-rich-text",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header__1.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings_schema.couleurs.settings.color_scheme.label",
      "info": "t:settings_schema.couleurs.settings.color_scheme.info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.rich_text.settings.header__2.content"
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 400,
      "max": 900,
      "step": 20,
      "default": 720,
      "unit": "px",
      "label": "t:sections.rich_text.settings.content_width.label",
      "info": "t:sections.rich_text.settings.content_width.info"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.rich_text.settings.text_alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.rich_text.settings.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.rich_text.settings.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.rich_text.settings.text_alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px",
      "label": "t:sections.rich_text.settings.padding_top.label"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 64,
      "unit": "px",
      "label": "t:sections.rich_text.settings.padding_bottom.label"
    }
  ],
  "blocks": [
    {
      "type": "eyebrow",
      "name": "t:sections.rich_text.blocks.eyebrow.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.rich_text.blocks.eyebrow.settings.text.label",
          "default": "Our house"
        }
      ]
    },
    {
      "type": "heading",
      "name": "t:sections.rich_text.blocks.heading.name",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.rich_text.blocks.heading.settings.text.label",
          "default": "Clothes made to last"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:sections.rich_text.blocks.heading.settings.heading_tag.label",
          "info": "t:sections.rich_text.blocks.heading.settings.heading_tag.info",
          "options": [
            {
              "value": "h1",
              "label": "t:sections.rich_text.blocks.heading.settings.heading_tag.options__1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.rich_text.blocks.heading.settings.heading_tag.options__2.label"
            },
            {
              "value": "h3",
              "label": "t:sections.rich_text.blocks.heading.settings.heading_tag.options__3.label"
            }
          ],
          "default": "h2"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich_text.blocks.text.name",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "t:sections.rich_text.blocks.text.settings.text.label",
          "default": "<p>Every piece is drawn in our atelier and made in small runs, from materials chosen for their weight and their feel.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich_text.blocks.button.name",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:sections.rich_text.blocks.button.settings.label.label",
          "default": "Discover the collection"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.rich_text.blocks.button.settings.link.label"
        },
        {
          "type": "select",
          "id": "style",
          "label": "t:sections.rich_text.blocks.button.settings.style.label",
          "options": [
            {
              "value": "primary",
              "label": "t:sections.rich_text.blocks.button.settings.style.options__1.label"
            },
            {
              "value": "secondary",
              "label": "t:sections.rich_text.blocks.button.settings.style.options__2.label"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich_text.presets.name",
      "category": "t:categories.text",
      "blocks": [
        {
          "type": "eyebrow"
        },
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
