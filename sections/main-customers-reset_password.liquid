{% comment %}Section: Réinitialisation du mot de passe{% endcomment %}
{%- assign errors_id = 'ResetErrors-' | append: section.id -%}
<div class="page-shell page-shell--narrow">
  <div class="page-shell__header">
    <h1 class="page-shell__title">{{ 'customer.reset_password.title' | t }}</h1>
    <p class="page-shell__subtitle">{{ 'customer.reset_password.subtext' | t }}</p>
  </div>

  {%- form 'reset_customer_password', class: 'customer__form' -%}
    {% render 'form-errors', form: form, id: errors_id %}

    <label for="ResetPassword">
      {{ 'customer.reset_password.password' | t }}
      <span class="form__required-mark" aria-hidden="true">*</span>
    </label>
    <input
      type="password"
      id="ResetPassword"
      name="customer[password]"
      autocomplete="new-password" required
      {%- if form.errors contains 'password' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    <label for="ResetPasswordConfirm">
      {{ 'customer.reset_password.password_confirm' | t }}
      <span class="form__required-mark" aria-hidden="true">*</span>
    </label>
    <input
      type="password"
      id="ResetPasswordConfirm"
      name="customer[password_confirmation]"
      autocomplete="new-password" required
      {%- if form.errors contains 'password_confirmation' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    {% render 'required-note' %}

    <button type="submit" class="btn btn--primary">{{ 'customer.reset_password.submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "t:sections.main_customers_reset_password.name",
  "tag": "section",
  "class": "section-customers",
  "settings": []
}
{% endschema %}
