{% comment %}
  Section: Page mot de passe
{% endcomment %}

<div class="password-page">
  <div class="password-page__inner">
    {%- if shop.brand.logo -%}
      <img
        class="password-page__logo"
        src="{{ shop.brand.logo | image_url: width: 200 }}"
        alt="{{ shop.name | escape }}"
        width="200"
        height="{{ 200 | times: shop.brand.logo.height | divided_by: shop.brand.logo.width }}"
      >
    {%- else -%}
      <h1 class="password-page__shop">{{ shop.name }}</h1>
    {%- endif -%}

    <h2 class="password-page__title">{{ 'password_page.title' | t }}</h2>
    <p class="password-page__message">{{ 'password_page.message' | t }}</p>

    {%- form 'storefront_password', class: 'password-page__form' -%}
      <label class="visually-hidden" for="StorefrontPassword">{{ 'password_page.password_label' | t }}</label>
      <input
        type="password"
        id="StorefrontPassword"
        name="password"
        class="password-page__input"
        autocomplete="current-password"
        placeholder="{{ 'password_page.password_label' | t }}"
        required
        {%- if form.errors %} aria-invalid="true" aria-describedby="StorefrontPasswordErrors"{% endif -%}
      >
      <button type="submit" class="btn btn--primary">{{ 'password_page.submit' | t }}</button>
      {%- if form.errors -%}
        <p id="StorefrontPasswordErrors" class="form__error" role="alert" tabindex="-1" autofocus>
          {{ 'password_page.login_form_error' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}

    <p class="password-page__admin">
      <a href="https://shopify.com" rel="nofollow">{{ 'password_page.admin_link' | t }}</a>
    </p>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "tag": "section",
  "class": "section-password",
  "settings": []
}
{% endschema %}
