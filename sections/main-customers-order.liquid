{% comment %}Section: Détail de commande{% endcomment %}
<div class="page-shell page-shell--wide">
  {%- assign order_date = order.created_at | date: format: 'date' -%}
  <div class="page-shell__header">
    <h1 class="page-shell__title">{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p class="page-shell__subtitle">{{ 'customer.order.date_html' | t: date: order_date }}</p>
  </div>

  <table class="account__table">
    <thead>
      <tr>
        <th scope="col">{{ 'customer.order.product' | t }}</th>
        <th scope="col">{{ 'customer.order.sku' | t }}</th>
        <th scope="col">{{ 'customer.order.price' | t }}</th>
        <th scope="col">{{ 'customer.order.quantity' | t }}</th>
        <th scope="col">{{ 'customer.order.total' | t }}</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>
            <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
          </td>
          <td>{{ line_item.sku }}</td>
          <td>{% render 'money', amount: line_item.final_price %}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{% render 'money', amount: line_item.final_line_price %}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr>
        <th scope="row" colspan="4">{{ 'customer.order.subtotal' | t }}</th>
        <td>{% render 'money', amount: order.line_items_subtotal_price %}</td>
      </tr>
      {%- for shipping_method in order.shipping_methods -%}
        <tr>
          <th scope="row" colspan="4">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</th>
          <td>{% render 'money', amount: shipping_method.price %}</td>
        </tr>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <tr>
          <th scope="row" colspan="4">{{ 'customer.order.tax' | t }} ({{ tax_line.title }})</th>
          <td>{% render 'money', amount: tax_line.price %}</td>
        </tr>
      {%- endfor -%}
      <tr>
        <th scope="row" colspan="4">{{ 'customer.order.total' | t }}</th>
        <td>{% render 'money', amount: order.total_net_amount %}</td>
      </tr>
    </tfoot>
  </table>

  <div class="account__addresses">
    <div>
      <h2 class="customer__subtitle">{{ 'customer.order.billing_address' | t }}</h2>
      <p>{{ 'customer.order.payment_status' | t }}{{ 'general.punctuation.colon' | t }}{{ order.financial_status_label }}</p>
      {{ order.billing_address | format_address }}
    </div>
    <div>
      <h2 class="customer__subtitle">{{ 'customer.order.shipping_address' | t }}</h2>
      <p>{{ 'customer.order.fulfillment_status' | t }}{{ 'general.punctuation.colon' | t }}{{ order.fulfillment_status_label }}</p>
      {{ order.shipping_address | format_address }}
    </div>
  </div>

  <a href="{{ routes.account_url }}" class="btn btn--link">{{ 'customer.account.return' | t }}</a>
</div>

{% schema %}
{
  "name": "t:sections.main_customers_order.name",
  "tag": "section",
  "class": "section-customers",
  "settings": []
}
{% endschema %}
