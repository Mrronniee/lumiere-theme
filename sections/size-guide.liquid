            "col_4": "60"
          }
        },
        {
          "type": "row",
          "settings": {
            "label": "M",
            "col_1": "90 - 94",
            "col_2": "72 - 76",
            "col_3": "96 - 100",
            "col_4": "61"
          }
        },
        {
