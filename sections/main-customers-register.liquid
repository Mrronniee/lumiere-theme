{% comment %}Section: Création de compte{% endcomment %}
{%- assign errors_id = 'RegisterErrors-' | append: section.id -%}
<div class="page-shell page-shell--narrow">
  <div class="page-shell__header">
    <h1 class="page-shell__title">{{ 'customer.register.title' | t }}</h1>
  </div>

  {%- form 'create_customer', class: 'customer__form' -%}
    {% render 'form-errors', form: form, id: errors_id %}

    <label for="RegisterFirstName">
      {{ 'customer.register.first_name' | t }}
    </label>
    <input
      type="text"
      id="RegisterFirstName"
      name="customer[first_name]"
      autocomplete="given-name"
      {%- if form.errors contains 'first_name' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    <label for="RegisterLastName">
      {{ 'customer.register.last_name' | t }}
    </label>
    <input
      type="text"
      id="RegisterLastName"
      name="customer[last_name]"
      autocomplete="family-name"
      {%- if form.errors contains 'last_name' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    <label for="RegisterEmail">
      {{ 'customer.register.email' | t }}
      <span class="form__required-mark" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="RegisterEmail"
      name="customer[email]"
      autocomplete="email" required
      {%- if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    <label for="RegisterPassword">
      {{ 'customer.register.password' | t }}
      <span class="form__required-mark" aria-hidden="true">*</span>
    </label>
    <input
      type="password"
      id="RegisterPassword"
      name="customer[password]"
      autocomplete="new-password" required
      {%- if form.errors contains 'password' %} aria-invalid="true" aria-describedby="{{ errors_id }}"{% endif -%}
    >

    {% render 'required-note' %}

    <button type="submit" class="btn btn--primary">{{ 'customer.register.submit' | t }}</button>
  {%- endform -%}

  <p class="customer__alt">
    {{ 'customer.register.already_have_account' | t }}
    <a href="{{ routes.account_login_url }}">{{ 'customer.login.sign_in' | t }}</a>
  </p>
</div>

{% schema %}
{
  "name": "t:sections.main_customers_register.name",
  "tag": "section",
  "class": "section-customers",
  "settings": []
}
{% endschema %}
